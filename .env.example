# ===== إعدادات عامة =====
APP_NAME="منظومة تحليل إنستاجرام"
APP_DEBUG=false
APP_TIMEZONE=Asia/Riyadh

# ===== Instagram Graph API (المصدر الرسمي والأدق) =====
# احصل عليها من: https://developers.facebook.com  (Instagram Graph API)
# يتطلب حساب إنستاجرام للأعمال/منشئ محتوى مرتبطًا بصفحة فيسبوك.
IG_ACCESS_TOKEN=
IG_USER_ID=
# اسم المستخدم المالك للتوكن — يُستخدم لقراءة التعليقات والردود.
IG_OWNER_USERNAME=
IG_API_VERSION=v21.0

# ===== الواجهة العامة (بدون توكن) =====
# تُستخدم للتحقق من توفّر أسماء المستخدمين. قد يحدّها إنستاجرام بالطلبات.
IG_PUBLIC_WEB_ENABLED=true

# ===== وضع التجربة =====
# بيانات مُصطنعة حتمية لتشغيل الواجهات بدون مفاتيح. اجعلها false في الإنتاج.
IG_DEMO_ENABLED=true

# ===== التخزين المؤقت وحدود الطلبات =====
CACHE_ENABLED=true
CACHE_TTL=900
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW=60

# ===== إعدادات التحليل =====
ANALYSIS_MEDIA_LIMIT=25
ANALYSIS_COMMENT_POSTS=5
ANALYSIS_COMMENTS_PER_POST=50
USERNAME_SUGGESTIONS=6
USERNAME_SUGGESTION_CHECKS=4

# ===== قائمة مراقبة أسماء المستخدمين =====
WATCHLIST_STORAGE_PATH=
WATCHLIST_MAX_ENTRIES=30

# ===== تنبيهات عقارية عبر واتساب — مصدر omanreal.com =====
# مُحدِّدات المصدر — يجب اكتشافها يدويًا من الموقع فعليًا (راجع README):
PROPERTY_SOURCE_URL=https://omanreal.com/Properties
PROPERTY_LOCATION_PARAM=
PROPERTY_TYPE_PARAM=
# مُحدِّدات XPath لاستخراج كل بطاقة إعلان — غير مضبوطة افتراضيًا عمدًا:
PROPERTY_XPATH_ITEM=
PROPERTY_XPATH_TITLE=.
PROPERTY_XPATH_URL=.//a/@href
PROPERTY_XPATH_LOCATION=.
PROPERTY_XPATH_PRICE=.
# قيم فلتر نوع الأرض كما يتوقّعها الموقع (افتراضيًا نفس المفتاح الداخلي):
PROPERTY_TYPE_AGRICULTURAL=agricultural
PROPERTY_TYPE_RESIDENTIAL=residential
PROPERTY_TYPE_INDUSTRIAL=industrial
PROPERTY_TYPE_COMMERCIAL=commercial

# ===== تنبيهات عقارية عبر واتساب — مصدر السوق المفتوح (OpenSooq) =====
# نفس الفكرة تمامًا، لموقع مختلف — غير مضبوطة افتراضيًا لنفس السبب (راجع README):
OPENSOOQ_SOURCE_URL=https://om.opensooq.com/ar/عقارات-للبيع/اراضي-للبيع
OPENSOOQ_LOCATION_PARAM=
OPENSOOQ_TYPE_PARAM=
OPENSOOQ_XPATH_ITEM=
OPENSOOQ_XPATH_TITLE=.
OPENSOOQ_XPATH_URL=.//a/@href
OPENSOOQ_XPATH_LOCATION=.
OPENSOOQ_XPATH_PRICE=.
OPENSOOQ_TYPE_AGRICULTURAL=agricultural
OPENSOOQ_TYPE_RESIDENTIAL=residential
OPENSOOQ_TYPE_INDUSTRIAL=industrial
OPENSOOQ_TYPE_COMMERCIAL=commercial

# ===== إرسال واتساب (يخدم كل المصادر أعلاه) =====
# WhatsApp Cloud API الرسمي من Meta: https://developers.facebook.com/docs/whatsapp/cloud-api
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

PROPERTY_ALERTS_STORAGE_PATH=
PROPERTY_ALERTS_MAX_ENTRIES=50
PROPERTY_ALERTS_MAX_NOTIFY=5
